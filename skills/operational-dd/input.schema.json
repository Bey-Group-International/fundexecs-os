{
  "type": "object",
  "properties": {
    "dealName": {
      "type": "string"
    },
    "documentsReceived": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedDocuments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revenue": {
      "type": "number",
      "minimum": 0
    },
    "costBase": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["function", "cost"],
        "properties": {
          "function": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "benchmarkPctOfRevenue": {
            "type": "number",
            "minimum": 0
          },
          "documentRef": {
            "type": "string"
          }
        }
      }
    },
    "reportedCostBase": {
      "type": "number",
      "minimum": 0
    },
    "tieOutToleranceAbs": {
      "type": "number",
      "minimum": 0
    },
    "benchmarkTolerancePts": {
      "type": "number",
      "minimum": 0
    },
    "capacity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "capacity"],
        "properties": {
          "unit": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "currentVolume": {
            "type": "number",
            "minimum": 0
          },
          "capacity": {
            "type": "number",
            "minimum": 0
          },
          "planVolume": {
            "type": "number",
            "minimum": 0
          },
          "documentRef": {
            "type": "string"
          }
        }
      }
    },
    "warnAbovePct": {
      "type": "number",
      "minimum": 0
    },
    "keyPeople": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "type": "string"
          },
          "retentionRisk": {
            "type": "string",
            "enum": ["low", "medium", "high", "unknown"]
          },
          "knowledgeDocumented": {
            "type": "boolean"
          },
          "documentRef": {
            "type": "string"
          }
        }
      }
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "spend"],
        "properties": {
          "name": {
            "type": "string"
          },
          "spend": {
            "type": "number",
            "minimum": 0
          },
          "critical": {
            "type": "boolean"
          },
          "alternativeSupplier": {
            "type": "string",
            "enum": ["yes", "no", "unknown"]
          },
          "documentRef": {
            "type": "string"
          }
        }
      }
    },
    "supplierConcentrationPct": {
      "type": "number",
      "minimum": 0
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "current", "plan"],
        "properties": {
          "name": {
            "type": "string"
          },
          "current": {
            "type": "number"
          },
          "plan": {
            "type": "number"
          },
          "documentRef": {
            "type": "string"
          }
        }
      }
    },
    "kpiPolicy": {
      "type": "object",
      "properties": {
        "materialityPct": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "inPlan"],
        "properties": {
          "name": {
            "type": "string"
          },
          "inPlan": {
            "type": "boolean"
          },
          "savingLow": {
            "type": "number",
            "minimum": 0
          },
          "savingHigh": {
            "type": "number",
            "minimum": 0
          },
          "savingBasis": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "evidenceGrade": {
            "type": "string",
            "enum": ["A", "B", "C", "U"]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "rating"],
        "properties": {
          "title": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": ["red", "amber", "green"]
          },
          "category": {
            "type": "string",
            "enum": [
              "cost-base",
              "capacity",
              "people",
              "suppliers",
              "improvements",
              "other"
            ]
          },
          "jurisdiction": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "documentRef": {
            "type": "string"
          },
          "clauseRef": {
            "type": "string"
          },
          "evidenceGrade": {
            "type": "string",
            "enum": ["A", "B", "C", "U"]
          },
          "impact": {
            "type": "string",
            "enum": [
              "walk-away",
              "price",
              "structure",
              "spa-protection",
              "100-day"
            ]
          },
          "question": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "rangeLow": {
            "type": "number",
            "minimum": 0
          },
          "rangeHigh": {
            "type": "number",
            "minimum": 0
          },
          "rangeBasis": {
            "type": "string"
          }
        }
      }
    },
    "categoriesReviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cost-base", "capacity", "people", "suppliers", "improvements"]
      }
    },
    "siteVisitDone": {
      "type": "boolean"
    },
    "evidencePolicy": {
      "type": "object",
      "properties": {
        "supportsPrice": {
          "type": "object",
          "properties": {
            "A": {
              "type": "boolean"
            },
            "B": {
              "type": "boolean"
            },
            "C": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "gateOwner": {
      "type": "string"
    }
  }
}

{
  "type": "object",
  "required": [
    "costMap",
    "capacity",
    "suppliers",
    "kpis",
    "improvements",
    "planSavings",
    "outsidePlan",
    "issues",
    "counts",
    "documentGaps",
    "categoriesNotReviewed",
    "uncited",
    "rangesDropped",
    "evidencePolicyIsDefault",
    "basisOfReview",
    "duplicatesMerged",
    "derivedCount",
    "handoff",
    "limitation",
    "note",
    "gate"
  ],
  "properties": {
    "costMap": {
      "type": "object",
      "required": ["rows", "benchmarkToleranceIsDefault"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["function", "cost", "pctOfTotal", "vsBenchmark"],
            "properties": {
              "function": {
                "type": "string"
              },
              "cost": {
                "type": "number"
              },
              "pctOfTotal": {
                "type": "number"
              },
              "vsBenchmark": {
                "type": "string",
                "enum": [
                  "above",
                  "below",
                  "in-line",
                  "no-benchmark",
                  "no-revenue"
                ]
              }
            }
          }
        },
        "benchmarkToleranceIsDefault": {
          "type": "boolean"
        }
      }
    },
    "capacity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "capacity", "status"],
        "properties": {
          "unit": {
            "type": "string"
          },
          "capacity": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["breach", "warn", "within", "plan-volume-missing"]
          }
        }
      }
    },
    "suppliers": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "spend",
              "sharePct",
              "critical",
              "alternativeSupplier"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "spend": {
                "type": "number"
              },
              "sharePct": {
                "type": "number"
              },
              "critical": {
                "type": "boolean"
              },
              "alternativeSupplier": {
                "type": "string",
                "enum": ["yes", "no", "unknown"]
              }
            }
          }
        }
      }
    },
    "kpis": {
      "type": "object",
      "required": ["rows", "materialityPct", "policyIsDefault"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "current", "plan", "material"],
            "properties": {
              "name": {
                "type": "string"
              },
              "current": {
                "type": "number"
              },
              "plan": {
                "type": "number"
              },
              "material": {
                "type": "boolean"
              }
            }
          }
        },
        "materialityPct": {
          "type": "number"
        },
        "policyIsDefault": {
          "type": "boolean"
        }
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "inPlan",
          "status",
          "evidenceGrade",
          "canSupportPrice"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "inPlan": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["evidenced", "untested"]
          },
          "evidenceGrade": {
            "type": "string",
            "enum": ["A", "B", "C", "U"]
          },
          "canSupportPrice": {
            "type": "boolean"
          }
        }
      }
    },
    "planSavings": {
      "type": "object",
      "properties": {
        "evidenced": {
          "type": "object",
          "required": ["low", "high", "count"],
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "count": {
              "type": "number"
            }
          }
        },
        "untested": {
          "type": "object",
          "required": ["low", "high", "count"],
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "count": {
              "type": "number"
            }
          }
        },
        "priceSupported": {
          "type": "object",
          "required": ["low", "high", "count"],
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "count": {
              "type": "number"
            }
          }
        }
      }
    },
    "outsidePlan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "title",
          "rating",
          "category",
          "evidenceGrade",
          "cited",
          "derived",
          "notes"
        ],
        "properties": {
          "rank": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": ["red", "amber", "green"]
          },
          "category": {
            "type": "string"
          },
          "evidenceGrade": {
            "type": "string",
            "enum": ["A", "B", "C", "U"]
          },
          "cited": {
            "type": "boolean"
          },
          "derived": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["red", "amber", "green"],
      "properties": {
        "red": {
          "type": "number"
        },
        "amber": {
          "type": "number"
        },
        "green": {
          "type": "number"
        }
      }
    },
    "documentGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categoriesNotReviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cost-base", "capacity", "people", "suppliers", "improvements"]
      }
    },
    "uncited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rangesDropped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidencePolicyIsDefault": {
      "type": "boolean"
    },
    "basisOfReview": {
      "type": "string"
    },
    "duplicatesMerged": {
      "type": "number"
    },
    "derivedCount": {
      "type": "number"
    },
    "handoff": {
      "type": "object",
      "required": ["findings", "needingImpact"],
      "properties": {
        "findings": {
          "type": "array"
        },
        "needingImpact": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitation": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    }
  }
}
